extends includes/layout.pug

block content
  #post
    if top_img === false
      include includes/header/post-info.pug

    - const articleSource = String(page.content || '')
    - const firstHeading = articleSource.match(/^(?:\s*<!--[\s\S]*?-->\s*)*<h1(?:\s[^>]*)?>[\s\S]*?<\/h1>\s*/i)
    - const decodeHeading = value => value.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/\s+/g, ' ').trim()
    - const articleHeading = firstHeading ? decodeHeading(firstHeading[0]) : ''
    - const pageHeading = decodeHeading(String(page.title || ''))
    - const removeDuplicateHeading = firstHeading && articleHeading === pageHeading
    - const firstHeadingIdMatch = removeDuplicateHeading ? firstHeading[0].match(/\sid="([^"]+)"/i) : null
    - const firstHeadingId = firstHeadingIdMatch ? firstHeadingIdMatch[1] : ''
    - const articleBody = removeDuplicateHeading ? articleSource.slice(firstHeading[0].length) : articleSource

    article#article-container.container.post-content
      if firstHeadingId
        span.post-title-anchor(id=firstHeadingId aria-hidden="true")
      if theme.noticeOutdate.enable && page.noticeOutdate !== false
        include includes/post/outdate-notice.pug
      else
        !=articleBody
    include includes/post/post-copyright.pug
    .tag_share
      if (page.tags.length > 0 && theme.post_meta.post.tags)
        .post-meta__tag-list
          each item, index in page.tags.data
            a(href=url_for(item.path)).post-meta__tags #[=item.name]
      include includes/third-party/share/index.pug

    if theme.reward.enable && theme.reward.QR_code
      !=partial('includes/post/reward', {}, {cache: true})

    //- ad
    if theme.ad && theme.ad.post
      .ads-wrap!=theme.ad.post

    if theme.post_pagination
      include includes/pagination.pug
    if theme.related_post && theme.related_post.enable
      != related_posts(page,site.posts)

    if page.comments !== false && theme.comments.use
      - var commentsJsLoad = true
      !=partial('includes/third-party/comments/index', {}, {cache: true})
